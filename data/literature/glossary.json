    {
      "term": "RoPE 外推",
      "full_name": "Rotary Position Embedding 长度外推",
      "zh": "旋转位置编码外推",
      "plain_explanation": "长上下文的关键技术点：位置编码如何泛化到训练未见的长度（YaRN 等）",
      "url": "https://arxiv.org/abs/2309.00071"
